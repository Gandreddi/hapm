# Local development values only. Never put real secrets here.
POSTGRES_PASSWORD=hapm-local-dev
HAPM_APP_DB_PASSWORD=hapm-app-local
HAPM_READONLY_DB_PASSWORD=hapm-ro-local
HAPM_LOG_LEVEL=INFO
HAPM_OTEL_ENDPOINT=
# Azurite's public, well-known development account key (not a secret).
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
# Real provider keys (optional; the demo uses the Fake provider). Use Key Vault references in cloud.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Container engine: docker or podman (default: docker if installed, else podman).
# HAPM_CONTAINER_CLI=podman
# Podman only: the engine socket inside the Podman machine, mounted into the sandbox service.
# Rootful machine: /run/podman/podman.sock   Rootless: /run/user/1000/podman/podman.sock
# HAPM_CONTAINER_SOCKET=/run/podman/podman.sock
