# Sentinel graphify engine (ADR-0021). graphifyy is installed only from PyPI at the pinned version, with
# every wheel hash-checked (graphify-requirements.txt, generated by `uv pip compile --generate-hashes`).
# Runs as a non-root user; Sentinel starts it with the network disabled and the repository mounted read-only.
FROM docker.io/library/python:3.12.15-slim-trixie
COPY graphify-requirements.txt /tmp/graphify-requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check --require-hashes -r /tmp/graphify-requirements.txt \
    && rm /tmp/graphify-requirements.txt \
    && useradd --create-home --uid 10001 sentinel
USER sentinel
WORKDIR /work
ENV GRAPHIFY_BACKEND=none

